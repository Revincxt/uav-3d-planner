{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAV 3D Planner Lab recorded demo bundle",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "verificationStatus",
    "coordinateSystem",
    "defaultScenarioId",
    "planners",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "verificationStatus": { "const": "DEMO_NON_CONFIRMATORY" },
    "defaultScenarioId": { "type": "string" },
    "coordinateSystem": {
      "type": "object",
      "required": ["frame", "distanceUnit", "timeUnit"],
      "properties": {
        "frame": { "const": "ENU" },
        "distanceUnit": { "const": "m" },
        "timeUnit": { "const": "ms" }
      }
    },
    "planners": { "type": "array", "minItems": 3 },
    "scenarios": { "type": "array", "minItems": 4 }
  }
}

